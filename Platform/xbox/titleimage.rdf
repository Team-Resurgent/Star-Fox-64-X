// Dashboard title icon (128x128). The build engine runs the RXDK bundler on
// this before linking; imagebld puts the .xbx in the XBE (rxdk.project.json
// imageBuild.titleImage). The BMP is made from the ROM by
// tools/xbox/make_icons.py; DXT1 is the only format the dashboard renders.

out_version        XPR0
out_packedresource gen/titleimage.xbx
out_header         gen/titleimage.h

Texture TitleImage
{
   Source gen/titleimage.bmp
   Format D3DFMT_DXT1
   Levels 1
}
